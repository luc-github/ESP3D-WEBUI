import { h } from "preact"

const formatCapabilityLine = (acc, line) => {
    //TODO:
    //isolate description
    //sort enabled
    //sort disabled
    acc.push({ data: line })
    return acc
}

const formatEepromLine = (acc, line) => {
    //format G20 / G21
    //it is comment
    if (line.startsWith("echo:")) {
        //it is setting
        const data = line
            .substring(
                5,
                line.indexOf(";") != -1 ? line.indexOf(";") : line.length
            )
            .trim()

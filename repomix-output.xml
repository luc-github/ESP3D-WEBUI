import { h } from "preact"

const isVerboseOnly = (type, data) => {
    const line = data.trim()
    if (
        line.trim().length == 0 ||
        line.startsWith("[") ||
        line.startsWith("ok") ||
        line.startsWith("<") ||
        line.startsWith("SENSOR:") ||
        (line.startsWith("{") && line.endsWith("}"))
    )
        return true
    else return false
}


import { Fragment, h } from "preact"
import {
    FormGroup,
    Input,
    Select,
    Boolean,
    PickUp,
    ItemsList,
    IconSelect,
    LabelCtrl,
    Slider,
    Mask,
} from "./Fields"

const Field = (props) => {
    const { type, id, help } = props
    switch (type) {
        case "mask":
        case "xmask":
            return (
                <div>
                    <Mask {...props} />
                    <FormGroup {...props}></FormGroup>
                </div>
            )
        case "label":
            return (
                <FormGroup {...props}>
                    <LabelCtrl {...props} />
                </FormGroup>
            )
        case "list":
            return (
                <Fragment>
                    <ItemsList {...props} />
                    <FormGroup {...props} />
                </Fragment>
            )
        case "pickup":
            return (
                <FormGroup {...props}>
                    <PickUp {...props} />
                </FormGroup>
            )
        case "icon":
            return (
                <FormGroup {...props}>
                    <IconSelect {...props} />
                </FormGroup>
            )
        case "select":
            return (
                <FormGroup {...props}>
                    <Select {...props} />
                </FormGroup>
            )
        case "slider":
            return (
                <FormGroup {...props}>
                    <Slider {...props} />
                </FormGroup>
            )
        case "boolean":
            return (
                <FormGroup {...props}>
                    <Boolean {...props} />
                </FormGroup>
            )
        default:
            //input
            return (
                <FormGroup {...props}>
                    <Input {...props} />
                </FormGroup>
            )
    }
}
export { Field }

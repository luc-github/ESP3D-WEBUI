    } else {
        if (useUiContextFn.getValue("swap_x_y")) {
            H_axis_left_dir = "-"
            H_axis_right_dir = "+"
        } else {
            V_axis_top_dir = "+"
            V_axis_bottom_dir = "-"
            pos_x_v_axis_label_top = "110"
            pos_x_v_axis_label_bottom = "113"

# HTTPS front for the dev/mock servers (test https / wss / br behaviour)
# Started by `npm run dev-xxx secure` (see config/dev.js), or by hand:
#   caddy run --config config/Caddyfile
#  - https://localhost:8443 -> webpack dev server 8088 (dev bundle)
#  - https://localhost      -> same, on default port 443 (http://localhost redirects)
#  - https://localhost:8445 -> mock HTTP server 8080 (Flash/index.html.br or .gz)
#  - wss://localhost:8444   -> mock WebSocket server 8089
#    (the mock reports WebSocketPort 8444 when WS_PUBLIC_PORT=8444)
# Caddy uses its local CA and installs it in the Windows trust store on first
# run (confirm the Windows dialog), so no certificate warning in Chrome/Edge.
{
	local_certs
}

https://localhost:8443 {
	reverse_proxy localhost:8088
}

# Default port (443), like a real HTTPS reverse proxy without port in the URL.
# Caddy also listens on 80 and redirects http://localhost to https://localhost.
https://localhost {
	reverse_proxy localhost:8088
}

https://localhost:8444 {
	reverse_proxy localhost:8089
}

https://localhost:8445 {
	reverse_proxy localhost:8080
}
